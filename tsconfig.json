{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["db/**/*.ts", "netlify/**/*.mts", "netlify/edge-functions/**/*.ts", "server/netlify/**/*.ts", "tests/**/*.ts", "drizzle.config.ts"]
}
