# Reference only: Django currently reads process environment variables.
# This file is NOT automatically loaded. Set variables in PowerShell or hosting settings.
# Never commit real secrets or copy actual credentials into this example.

DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0; generate your own secret value.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LEAD_FORM_ORIGINS=https://your-website.example
SUPPORT_FORM_ORIGINS=https://your-website.example
DEFAULT_FROM_EMAIL=flowdesk@localhost
