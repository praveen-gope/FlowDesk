# Netlify dashboard environment settings; never put these in public JavaScript.
# Netlify Database provisions NETLIFY_DB_URL automatically.
# NETLIFY_DB_URL=postgresql://...
# First administrator: must be a confirmed account in Netlify Identity.
# Default matches the project owner. Set blank to disable further bootstrap.
FLOWDESK_FIRST_ADMIN_EMAIL=kr.praveengope@gmail.com
# Optional alternative: exact Identity UUID (not a Django user ID).
# FLOWDESK_FIRST_ADMIN_ID=
# Origins of external websites that submit public forms, comma-separated.
LEAD_FORM_ORIGINS=
SUPPORT_FORM_ORIGINS=
